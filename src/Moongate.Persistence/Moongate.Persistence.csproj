<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Moongate.Core/Moongate.Core.csproj" />
        <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.311" />
        <PackageReference Include="MemoryPack" Version="1.21.4" />
        <PackageReference Include="ZLinq" Version="1.5.6" />
        <InternalsVisibleTo Include="Moongate.Persistence.Tests" />
        <InternalsVisibleTo Include="Moongate.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
        <PackageId>Moongate.Persistence</PackageId>
        <Description>Binary snapshot and journal persistence for serial-identified entities, powered by MemoryPack.</Description>
        <PackageTags>moongate;persistence;memorypack;serialization</PackageTags>
    </PropertyGroup>

</Project>
