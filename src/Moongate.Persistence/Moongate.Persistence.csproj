<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Moongate.Core/Moongate.Core.csproj"/>
        <ProjectReference Include="../Moongate.Persistence.Migrations/Moongate.Persistence.Migrations.csproj"/>
        <PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.311"/>
        <InternalsVisibleTo Include="Moongate.Persistence.Tests"/>
        <InternalsVisibleTo Include="Moongate.Tests"/>
    </ItemGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
        <PackageId>Moongate.Persistence</PackageId>
        <Description>Asynchronous PostgreSQL persistence for serial-identified entities, powered by FreeSql.</Description>
        <PackageTags>moongate;persistence;postgresql;freesql</PackageTags>
    </PropertyGroup>

</Project>
