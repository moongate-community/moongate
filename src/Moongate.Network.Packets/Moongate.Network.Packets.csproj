<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Moongate.Core/Moongate.Core.csproj" />
  </ItemGroup>


  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
    <PackageId>Moongate.Network.Packets</PackageId>
    <Description>Ultima Online packet definitions, span-based serialization, and packet registration for Moongate.</Description>
    <PackageTags>moongate;ultima-online;protocol;packets</PackageTags>
  </PropertyGroup>

</Project>
