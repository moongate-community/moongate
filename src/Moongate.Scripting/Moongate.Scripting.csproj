<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Moongate.Core/Moongate.Core.csproj" />
        <ProjectReference Include="../Moongate.Server.Core/Moongate.Server.Core.csproj" />
        <PackageReference Include="LuaCSharp" Version="0.5.6" />
        <InternalsVisibleTo Include="Moongate.Tests" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Assets/prelude.lua" LogicalName="Moongate.Scripting.Assets.prelude.lua" />
    </ItemGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
        <PackageId>Moongate.Scripting</PackageId>
        <Description>Embedded Lua scripting for Moongate: attribute-bound modules, loop-affine execution, timer-driven coroutines, and editor definitions.</Description>
        <PackageTags>moongate;lua;scripting;ultima-online</PackageTags>
    </PropertyGroup>
</Project>
