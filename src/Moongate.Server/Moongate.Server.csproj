<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The executable is mgserver, beside mgctl; the namespaces stay Moongate.Server. -->
        <AssemblyName>mgserver</AssemblyName>
        <RootNamespace>Moongate.Server</RootNamespace>
        <!-- The shard host ships as a published executable and a container image,
             never as a library on nuget.org. -->
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishSelfContained>true</PublishSelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Codename" Value="$(Codename)"/>
        <InternalsVisibleTo Include="Moongate.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../migrations/**/*" Link="migrations/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <!-- mgctl copies these into <root>/data; the game and standalone loaders need them. -->
        <Content Include="../../moongate_root/data/**/*" Link="data/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <!-- mgctl copies these into <root>/templates and <root>/scripts, keeping the files the operator changed. -->
        <Content Include="../../moongate_root/templates/**/*" Link="templates/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <!-- definitions.lua and .luarc.json are generated by the engine at startup, never shipped. -->
        <Content Include="../../moongate_root/scripts/**/*"
                 Exclude="../../moongate_root/scripts/definitions.lua;../../moongate_root/scripts/.luarc.json"
                 Link="scripts/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- These travel with the binaries: the AGPL asks for the licence to be conveyed
         alongside them, and the notices carry the attributions the bundled packages
         require. Publishing here covers both the release archives and the image. -->
    <ItemGroup>
        <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"/>
        <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog.Expressions" Version="5.0.0"/>
        <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="StackExchange.Redis" Version="3.3.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Moongate.Ctl/Moongate.Ctl.csproj" ReferenceOutputAssembly="false" Private="false"/>
        <ProjectReference Include="..\Moongate.Core\Moongate.Core.csproj"/>
        <ProjectReference Include="..\Moongate.Network.Packets\Moongate.Network.Packets.csproj"/>
        <ProjectReference Include="..\Moongate.Persistence\Moongate.Persistence.csproj"/>
        <ProjectReference Include="..\Moongate.Scripting\Moongate.Scripting.csproj"/>
        <ProjectReference Include="..\Moongate.Server.Core\Moongate.Server.Core.csproj"/>
        <ProjectReference Include="..\Moongate.Server.Ultima\Moongate.Server.Ultima.csproj"/>
        <ProjectReference Include="..\Moongate.Ultima\Moongate.Ultima.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\**\*.*"/>
        <EmbeddedResource Include="Assets\**\*.*"/>
    </ItemGroup>

    <!-- mgctl applies the migrations: keep it, with its own PostgreSQL driver, in a separate process and output directory. -->
    <Target Name="CopyDevelopmentMgctl" AfterTargets="Build">
        <ItemGroup>
            <_MgctlFiles Include="../Moongate.Ctl/bin/$(Configuration)/$(TargetFramework)/**/*"/>
        </ItemGroup>
        <Copy SourceFiles="@(_MgctlFiles)"
              DestinationFiles="@(_MgctlFiles->'$(OutDir)mgctl/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>
    <ItemGroup>
        <ProjectReference Include="../Moongate.Server.Admin/Moongate.Server.Admin.csproj"/>
    </ItemGroup>
</Project>
