<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.152.1"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1"/>
        <PackageReference Include="System.IO.Hashing" Version="10.0.12"/>
        <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Moongate.Tests"/>
    </ItemGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
        <PackageId>Moongate.Ultima</PackageId>
        <Description>Ultima Online client data readers and rendering utilities for MUL/UOP assets, maps, art, and localization.</Description>
        <PackageTags>moongate;ultima-online;mul;uop;assets</PackageTags>
    </PropertyGroup>

</Project>
