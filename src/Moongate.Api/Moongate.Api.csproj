<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>
        <PackageId>Moongate.Api</PackageId>
        <Description>Standalone typed MessagePack request/reply channels over mutually authenticated TLS with bounded execution and local peer authorization.</Description>
        <PackageTags>moongate;api;messagepack;tcp;mtls</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Moongate.Network/Moongate.Network.csproj"/>
        <PackageReference Include="MessagePack" Version="3.1.9"/>
        <InternalsVisibleTo Include="Moongate.Api.Tests"/>
    </ItemGroup>
</Project>
