<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>mgctl</AssemblyName>
        <IsPackable>false</IsPackable>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishSelfContained>true</PublishSelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishDocumentationFile>false</PublishDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="Codename" Value="$(Codename)"/>
        <!-- Written at every build: the header and the version command say when and how the binaries were built.
             The time changes at each build, so this project is compiled again even when nothing else changed. -->
        <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))"/>
        <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)"/>
        <EmbeddedResource Include="../Moongate.Server/Assets/header.txt" Link="Assets/header.txt"/>
        <ProjectReference Include="../Moongate.Core/Moongate.Core.csproj"/>
        <ProjectReference Include="../Moongate.MigrationRunner/Moongate.MigrationRunner.csproj"/>
        <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
