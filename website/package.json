{
  "name": "moongate-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "prepare:packets": "node scripts/build-packets.mjs",
    "prepare:lua": "node scripts/build-lua.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run prepare:docs && npm run prepare:packets && npm run prepare:lua && astro dev",
    "build": "npm run prepare:docs && npm run prepare:packets && npm run prepare:lua && astro build && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "preview": "astro preview",
    "check:translations": "node scripts/check-translations.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.2",
    "astro": "7.3.3",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "parse5": "8.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0"
  }
}
