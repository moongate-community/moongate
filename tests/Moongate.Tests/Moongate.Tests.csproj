<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Moongate.Persistence/Moongate.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Moongate.Core\Moongate.Core.csproj" />
    <ProjectReference Include="..\..\src\Moongate.Server\Moongate.Server.csproj" />
    <ProjectReference Include="..\..\src\Moongate.Server.Core\Moongate.Server.Core.csproj" />
    <ProjectReference Include="..\..\src\Moongate.Ultima\Moongate.Ultima.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TestSupport/Resources/Fixtures/Nested/sample.txt"
                      LogicalName="Moongate.Tests.TestSupport.Resources.Nested.sample.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fixtures/Plugins/FoundationPlugin/FoundationPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../Fixtures/Plugins/DependentPlugin/DependentPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../Fixtures/Plugins/FailingPlugin/FailingPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyPluginFixtures" AfterTargets="Build">
    <ItemGroup>
      <_FoundationPluginFiles Include="../Fixtures/Plugins/FoundationPlugin/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FoundationPluginFiles)"
          DestinationFiles="@(_FoundationPluginFiles->'$(OutDir)PluginFixtures/FoundationPlugin/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_DependentPluginFiles Include="../Fixtures/Plugins/DependentPlugin/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DependentPluginFiles)"
          DestinationFiles="@(_DependentPluginFiles->'$(OutDir)PluginFixtures/DependentPlugin/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_FailingPluginFiles Include="../Fixtures/Plugins/FailingPlugin/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FailingPluginFiles)"
          DestinationFiles="@(_FailingPluginFiles->'$(OutDir)PluginFixtures/FailingPlugin/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
