<?xml version="1.0" encoding="utf-8"?>
<!--
  Moongate - templates/gumps/stable_claim.xml

  What it is for:
    The list of the pets a player has in the stable, opened by a stablemaster at the word
    "claim": the frame is here, the rows come from stable_claim.rows in
    scripts/gumps/stable_claim.lua, one button and the name of the pet each, eight a page.
    A button takes that pet out of the stable.

  Arguments:
    stablemaster  the serial of the stablemaster that opened the list
-->
<gump id="stable_claim" x="120" y="90"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gump.xsd">
  <background x="0" y="0" gump="9200" width="380" height="300" />
  <text x="20" y="15" hue="1152">Pets in the stable</text>
  <slot name="rows" x="20" y="45" />
</gump>
