<?xml version="1.0" encoding="utf-8"?>
<!--
  Moongate - templates/gumps/go.xml

  What it is for:
    The gump of the named places staff travels to, opened by .go: the frame is
    here, the rows come from go.rows in scripts/gumps/go.lua, which lists one
    level of data/locations.toml (the maps, a map or a category) and pages it.

  Arguments:
    path  the level to list, such as "Felucca/Dungeons"; none for the maps
-->
<gump id="go" x="80" y="60"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gump.xsd">
  <background x="0" y="0" gump="9200" width="360" height="410" />
  <text x="20" y="15" hue="1152">Go to a place</text>
  <slot name="rows" x="20" y="40" />
</gump>
