<?xml version="1.0" encoding="utf-8"?>
<!--
  Moongate - templates/gumps/resurrect.xml

  What it is for:
    The question an ankh asks a ghost that double clicks it, a healer a ghost that
    comes near, and the Resurrection spell the ghost it is cast on: to come back to
    life or not. Continue calls resurrect.accept
    in scripts/gumps/resurrect.lua, Cancel calls resurrect.cancel, which leaves
    the ghost as it is.

  Arguments:
    ankh     the serial of the ankh that was used; none when a healer asked
    healer   the serial of the healer that offered; none when an ankh asked
    caster   the serial of the player whose Resurrection spell asked
-->
<gump id="resurrect" x="120" y="120"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="gump.xsd">
  <background x="0" y="0" gump="9200" width="320" height="170" />
  <html x="20" y="18" width="280" height="80">It is possible for you to be resurrected here. Do you wish to return to life?</html>
  <button x="20" y="125" up="4005" down="4007" on_click="accept" />
  <text x="55" y="126">Continue</text>
  <button x="180" y="125" up="4017" down="4019" on_click="cancel" />
  <text x="215" y="126">Cancel</text>
</gump>
