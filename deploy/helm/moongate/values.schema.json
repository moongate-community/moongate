{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["uo", "realms"],
  "properties": {
    "uo": {
      "type": "object",
      "required": ["existingClaim"],
      "properties": {
        "existingClaim": {"type": "string", "minLength": 1, "description": "PVC with the Ultima Online client files"}
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "encryptionMode": {"enum": ["Disabled", "Optional", "Required"]}
      }
    },
    "login": {
      "type": "object",
      "properties": {
        "service": {"$ref": "#/definitions/service"}
      }
    },
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "serverIndex", "advertisedAddress"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"},
          "name": {"type": "string", "minLength": 1},
          "serverIndex": {"type": "integer", "minimum": 1, "maximum": 255},
          "advertisedAddress": {"type": "string", "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"},
          "advertisedPort": {"type": "integer", "minimum": 1, "maximum": 65535},
          "service": {"$ref": "#/definitions/service"}
        }
      }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["LoadBalancer", "NodePort", "ClusterIP"]}
      }
    }
  }
}
