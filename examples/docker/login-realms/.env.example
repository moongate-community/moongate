# Absolute host path; the directory must exist and be readable by the container.
UO_DATA_PATH=/absolute/path/to/ultima

# Local access by default. Use a host LAN address to allow remote clients.
MOONGATE_BIND_ADDRESS=127.0.0.1
LOGIN_PORT=2593
GAME_1_PORT=2595
GAME_2_PORT=2596

# Non-secret PostgreSQL names. One server owns three independent databases.
POSTGRES_ADMIN_USER=moongate_admin
POSTGRES_ADMIN_DATABASE=postgres
ACCOUNTS_DATABASE=moongate_accounts
ACCOUNTS_SCHEMA_USER=moongate_accounts_schema
ACCOUNTS_RUNTIME_USER=moongate_accounts_runtime
REALM_1_DATABASE=moongate_realm_1
REALM_1_SCHEMA_USER=moongate_realm_1_schema
REALM_1_RUNTIME_USER=moongate_realm_1_runtime
REALM_2_DATABASE=moongate_realm_2
REALM_2_SCHEMA_USER=moongate_realm_2_schema
REALM_2_RUNTIME_USER=moongate_realm_2_runtime

# Export these nine secrets from Bitwarden in the shell that runs Compose.
# Never add their values to this file or another plaintext credential file:
# MOONGATE_POSTGRES_ADMIN_PASSWORD
# MOONGATE_ACCOUNTS_SCHEMA_PASSWORD
# MOONGATE_ACCOUNTS_RUNTIME_PASSWORD
# MOONGATE_REALM_1_SCHEMA_PASSWORD
# MOONGATE_REALM_1_RUNTIME_PASSWORD
# MOONGATE_REALM_2_SCHEMA_PASSWORD
# MOONGATE_REALM_2_RUNTIME_PASSWORD
# MOONGATE_REDIS_PASSWORD (64 hexadecimal characters)
# MOONGATE_HANDOFF_SECRET (at least 64 hexadecimal characters, distinct from Redis password)
